---
// "Related terms" at the bottom of a glossary page.
import type { DocsEntry } from "../../lib/docs";
import { relatedTerms, termHref } from "../../lib/glossary";

interface Props {
  entry: DocsEntry;
}

const related = await relatedTerms(Astro.props.entry);
---

{
  related.length > 0 && (
    <section class="related related-terms" data-pagefind-ignore>
      <h2>Related terms</h2>
      <ul>
        {related.map((term) => (
          <li>
            <a href={termHref(term)}>{term.data.title}</a>
            <span>{term.data.description}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* Doubled classes: these win over the list and heading styles of the
     text around them. */
  .related.related-terms {
    margin-top: var(--ha-space-12);
    padding-top: var(--ha-space-6);
    border-top: 1px solid var(--site-border);
  }

  .related-terms h2 {
    margin: 0 0 var(--ha-space-4);
    font-size: 20px;
  }

  .related-terms ul {
    display: grid;
    gap: var(--ha-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-terms li {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  a {
    font-weight: 650;
  }

  span {
    color: var(--site-text-muted);
  }
</style>
