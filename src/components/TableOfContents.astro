---
// "On this page", like Starlight. Lists the h2 and h3 headings of a page and
// highlights the section you are reading. A docs page renders it more than
// once (the column for wide screens, the folded menu for medium ones, and the
// panel for small ones), so it uses no ids of its own.
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// The list starts with "Overview", a link to the top of the page. A page
// that opens with its own "Overview" section, like the Design component
// pages, already has that entry, so it doesn't get a second one.
const hasOverview = items[0]?.text.trim().toLowerCase() === "overview";
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="title" aria-hidden="true">On this page</p>
      <ul>
        {!hasOverview && (
          <li>
            <a href="#_top" data-depth="2">Overview</a>
          </li>
        )}
        {items.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} data-depth={heading.depth}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Marks the link of the section at the top of the screen as current, in
  // every copy of the list at once. One scroll listener for the page, at
  // most one measurement per frame, and the links only change when the
  // section does.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const ids = [...new Set(links.map((link) => link.hash.slice(1)))];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  let currentId: string | undefined;
  let frame: number | undefined;

  function markCurrent() {
    frame = undefined;

    // The last heading above this line, a little below the header, is the
    // one being read.
    const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--site-header-height"));
    const line = (header || 72) + 48;
    let next = ids[0];

    for (const section of sections) {
      if (section.getBoundingClientRect().top > line) {
        break;
      }
      next = section.id;
    }

    if (next === currentId) {
      return;
    }

    currentId = next;
    for (const link of links) {
      if (link.hash === `#${currentId}`) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  if (sections.length > 0) {
    markCurrent();
    document.addEventListener(
      "scroll",
      () => {
        frame ??= requestAnimationFrame(markCurrent);
      },
      { passive: true },
    );
  }
</script>

<style>
  .title {
    margin: 0 0 var(--ha-space-3);
    font-size: 14px;
    font-weight: 700;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--site-border);
  }

  a {
    display: block;
    margin-left: -1px;
    padding: var(--ha-space-1) 0 var(--ha-space-1) var(--ha-space-3);
    border-left: 2px solid transparent;
    color: var(--site-text-muted);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
  }

  a[data-depth="3"] {
    padding-left: var(--ha-space-6);
  }

  a:hover {
    color: var(--site-text);
  }

  a[aria-current="true"] {
    border-left-color: var(--site-link);
    color: var(--site-link);
    font-weight: 600;
  }
</style>
