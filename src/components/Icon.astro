---
// The shapes are in src/lib/icons.ts, shared with the share cards.
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName | string;
  size?: number;
}

const { name, size = 20 } = Astro.props;
const paths = ICONS[name as IconName];
if (!paths) {
  throw new Error(`Unknown icon: ${name}`);
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
