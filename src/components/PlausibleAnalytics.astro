---
// Privacy-first, self-hosted analytics. The collected data is public, see
// PLAUSIBLE.dashboard.
//
// Visitors arriving from their own Home Assistant instance would otherwise
// send that private URL as the referrer. Anything not on the shared allow
// list is replaced before Plausible records it. The list is downloaded once
// per build by scripts/fetch-allowed-referrers.mjs and inlined here.
//
// Same approach as works-with.home-assistant.io.
import allowedReferrers from "../data/allowed-referrers.json";
import { PLAUSIBLE } from "../data/site";
---

{
  PLAUSIBLE.script && (
    <>
      <script is:inline async src={PLAUSIBLE.script} />
      <script is:inline define:vars={{ allowedReferrers }}>
        window.plausible =
          window.plausible ||
          function () {
            (plausible.q = plausible.q || []).push(arguments);
          };
        plausible.init =
          plausible.init ||
          function (options) {
            plausible.o = options || {};
          };

        plausible.init({
          transformRequest: function (payload) {
            var referrer = payload.r;
            if (!referrer) return payload;

            var host = "";
            try {
              host = new URL(referrer).hostname.replace(/\.$/, "");
            } catch (error) {
              // Unparseable referrer: falls through and gets replaced.
            }

            for (var i = 0; i < allowedReferrers.length; i++) {
              var domain = allowedReferrers[i];
              if (
                host === domain ||
                (host.length > domain.length &&
                  host.slice(-(domain.length + 1)) === "." + domain)
              ) {
                return payload;
              }
            }

            // One aggregate bucket, so we see how much gets filtered without
            // learning anything about individual visitors. .invalid is
            // reserved by RFC 2606 and never collides with a real domain.
            payload.r = "https://unlisted.invalid/";
            return payload;
          },
        });
      </script>
    </>
  )
}
