---
// A stack of layers, top to bottom, each with a row of boxes: what runs on
// what. Same look as the architecture map, so diagrams across the site feel
// like one family, and like the map they follow the theme and every box can
// link to its page.
import ArchitectureBox from "./ArchitectureBox.astro";

interface Box {
  title: string;
  text: string;
  href?: string;
}

interface Layer {
  label: string;
  href?: string;
  boxes: Box[];
  // The layer the page is about gets the accent border.
  highlight?: boolean;
}

interface Props {
  layers: Layer[];
  caption?: string;
}

const { layers, caption } = Astro.props;
---

<figure class="stack" data-pagefind-ignore>
  {
    layers.map((layer) => (
      <div class:list={["layer", { "layer--highlight": layer.highlight }]}>
        <p class="label">{layer.href ? <a href={layer.href}>{layer.label}</a> : layer.label}</p>
        <ul>
          {layer.boxes.map((box) => (
            <li>
              <ArchitectureBox {...box} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .stack {
    display: grid;
    gap: var(--ha-space-2);
    margin: var(--ha-space-8) 0;
  }

  .layer {
    padding: var(--ha-space-4);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-tile);
    background: var(--site-surface);
  }

  .layer--highlight {
    border-color: var(--site-link);
    border-width: 2px;
  }

  .label {
    margin: 0 0 var(--ha-space-3);
    font-size: 14px;
    font-weight: 700;
    color: var(--site-text-muted);
  }

  .label a {
    color: var(--site-text);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--ha-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wins over the spacing between list items in the text around it. */
  .stack li,
  .stack li + li {
    margin: 0;
  }

  figcaption {
    font-size: 14px;
    color: var(--site-text-muted);
  }
</style>
