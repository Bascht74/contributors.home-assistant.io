---
import { getBlogTopic } from "../data/blog-topics";
import { type BlogPost, postHref, titleParts } from "../lib/blog";
import PostByline from "./PostByline.astro";

interface Props {
  post: BlogPost;
  // The heading level of the title, so it fits the outline of the page the
  // card is on. Usually one below the heading of the list.
  headingLevel: 2 | 3 | 4;
  // The newest post, on top of the blog: bigger, and its description whole.
  featured?: boolean;
}

const { post, headingLevel, featured = false } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

{
  /*
   * The title is the link. Its ::after covers the whole card, so the card
   * is one target to select, while screen readers hear just the title as
   * the link and find the post in the list of headings.
   */
}
<article class:list={["card", { featured }]}>
  <div class="tags">
    {post.data.areas.map((id) => <span class="tag">{getBlogTopic(id)?.title}</span>)}
  </div>
  <Heading class="title">
    <a href={postHref(post)}>
      {titleParts(post.data.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
    </a>
  </Heading>
  <p class="description">{post.data.description}</p>
  <div class="meta">
    <PostByline post={post} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ha-space-3);
    height: 100%;
    padding: var(--ha-space-6);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-card);
    background: var(--site-surface);
    color: var(--site-text);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--site-link);
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* The focus ring goes around the card, not around the title alone. */
  .title a:focus-visible {
    outline: none;
  }

  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--site-focus);
    outline-offset: 3px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ha-space-1);
  }

  .tag {
    padding: 2px var(--ha-space-3);
    border-radius: var(--ha-border-radius-pill);
    background: var(--site-accent-quiet);
    color: var(--site-on-accent-quiet);
    font-size: 13px;
    font-weight: 650;
  }

  .title {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .featured {
    gap: var(--ha-space-4);
    padding: var(--ha-space-10);
  }

  .featured .title {
    font-size: clamp(28px, 3.5vw, 40px);
    letter-spacing: -0.025em;
  }

  .featured .description {
    max-width: 720px;
    font-size: 18px;
    -webkit-line-clamp: unset;
    line-clamp: unset;
  }

  .title code {
    font-size: 0.85em;
  }

  /* Some descriptions are long. Three lines is enough to know what a post is
     about, and keeps the cards in a row the same height. */
  .description {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    color: var(--site-text-muted);
    line-height: 1.5;
  }

  .meta {
    margin-top: auto;
    padding-top: var(--ha-space-4);
    border-top: 1px solid var(--site-border);
  }
</style>
