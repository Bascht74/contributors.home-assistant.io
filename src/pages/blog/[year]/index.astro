---
// One page per year of the blog, like /blog/2024/. The newest year is the
// front page of the blog itself.
import BlogArchive from "../../../components/BlogArchive.astro";
import { getPosts } from "../../../lib/blog";

export async function getStaticPaths() {
  const years = [...new Set((await getPosts()).map((post) => post.data.date.getUTCFullYear()))];

  return years.slice(1).map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props as { year: number };
---

<BlogArchive year={year} />
